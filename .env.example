# Copy to .env and fill in. Never commit .env.

# --- General ---
# local | production. Anything but local makes the session cookie Secure (HTTPS only) and
# requires a real JWT_SECRET below; the API and the worker refuse to start without one.
# The same applies as soon as SITE_ADDRESS is a domain name, whatever this says.
ENVIRONMENT=local

# --- Proxy (Caddy) ---
# ":80" locally; the domain name on the demo host (Caddy then gets an HTTPS certificate).
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# --- PostgreSQL ---
# docker-compose builds DATABASE_URL for the api and worker from these. Change the password on the
# demo host.
POSTGRES_USER=bookcrunch
POSTGRES_PASSWORD=bookcrunch
POSTGRES_DB=bookcrunch

# Used only when running the backend outside Docker (Docker overrides them):
DATABASE_URL=postgresql+asyncpg://bookcrunch:bookcrunch@localhost:5432/bookcrunch
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage

# --- Auth ---
# A long random string on the demo host:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 characters and not starting with "change-me" when ENVIRONMENT is not local.
JWT_SECRET=change-me

# --- Rate limits (optional; these are the defaults) ---
# Login attempts and registrations per client address per minute, uploads per user per hour.
# LOGIN_RATE_LIMIT=10
# REGISTER_RATE_LIMIT=5
# UPLOAD_RATE_LIMIT=20

# --- Parser (docs/contracts/parse_book.md) ---
# real: the EPUB and PDF parser. fake: a small fixed book, for working on the API or the UI
# without real files (automated tests set it themselves).
BOOKCRUNCH_PARSER=real
# Chunking, chapter notes and the book summary. Only "fake" exists until Track A's code is merged;
# the fakes make no LLM call. FAKE_NOTES_DELAY=1 waits a second per chapter and
# FAKE_SUMMARY_DELAY=5 five seconds per summary, to see the jobs in the UI.
BOOKCRUNCH_CHUNKER=fake
BOOKCRUNCH_NOTES=fake
BOOKCRUNCH_SUMMARY=fake

# --- LLM: open-weight models behind an OpenAI-compatible API (never called by automated tests) ---
# Locally: Ollama on your machine (https://ollama.com), then `ollama pull gemma3:4b` and
# `ollama pull gemma3:12b`. Give Ollama a context of at least 32k tokens (set
# OLLAMA_CONTEXT_LENGTH=32768 where Ollama runs); its small default would cut chapters off.
# Leave LLM_BASE_URL empty to use the default: Ollama on the host, as seen from the containers
# (http://host.docker.internal:11434/v1; http://localhost:11434/v1 when the backend runs outside
# Docker). A hosted provider: its OpenAI-compatible URL, e.g. https://api.groq.com/openai/v1.
# Check the settings with one real call: docker compose exec worker python scripts/llm_smoke.py
LLM_BASE_URL=
# Only hosted providers need a key.
LLM_API_KEY=
# Optional; these are the defaults. Every model named here needs a price in
# backend/config/prices.json ("0" for a model that costs nothing).
# LLM_MODEL_FAST=gemma3:4b
# LLM_MODEL_STRONG=gemma3:12b
# No new LLM call for a book that has already cost this much, in USD (FR-017).
# BOOK_COST_LIMIT_USD=2.00
# Parallel LLM requests in one worker process. Keep it low for Ollama on one machine.
# LLM_MAX_CONCURRENCY=5

# --- Embeddings (added in week 3): BAAI bge-m3 through the same kind of API ---
