# One origin for the browser: /api goes to FastAPI, everything else to Next.js (section 5.3).
# SITE_ADDRESS is ":80" locally (plain HTTP) and the domain name on the demo host, where Caddy
# obtains an HTTPS certificate automatically.
{$SITE_ADDRESS::80} {
	encode gzip

	# Uploads are limited to 50 MB (section 6.3); a little headroom for the multipart envelope.
	request_body {
		max_size 51MB
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
