# Copy to .env and fill in. Never commit .env.

# --- General ---
# local | production. Anything but local makes the session cookie Secure (HTTPS only) and
# requires a real JWT_SECRET below; the API and the worker refuse to start without one.
# The same applies as soon as SITE_ADDRESS is a domain name, whatever this says.
ENVIRONMENT=local

# --- Proxy (Caddy, proxy/Caddyfile) ---
# ":80" locally. The Railway values of this and the other proxy variables are in docs/deploy.md.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# --- PostgreSQL ---
# docker-compose builds DATABASE_URL for the api and worker from these. On Railway the database
# service provides DATABASE_URL (docs/deploy.md).
POSTGRES_USER=bookcrunch
POSTGRES_PASSWORD=bookcrunch
POSTGRES_DB=bookcrunch

# Used only when running the backend outside Docker (Docker overrides them):
DATABASE_URL=postgresql+asyncpg://bookcrunch:bookcrunch@localhost:5432/bookcrunch
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage

# --- Auth ---
# A long random string on Railway:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 characters and not starting with "change-me" when ENVIRONMENT is not local.
JWT_SECRET=change-me

# --- Rate limits (optional; these are the defaults) ---
# Login attempts per client address per minute, uploads per user per hour.
# LOGIN_RATE_LIMIT=10
# UPLOAD_RATE_LIMIT=20

# --- Parser (docs/contracts/parse_book.md) ---
# real: the EPUB and PDF parser. fake: a small fixed book, for working on the API or the UI
# without real files (automated tests set it themselves).
BOOKCRUNCH_PARSER=real

# --- External APIs (added with the LLM pipeline; never used by automated tests) ---
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
